# ============================================
# Environment Configuration
# ============================================

# Server Configuration
HTTP_PORT=8080

# PostgreSQL Database (Separate DBs for each service)
# Order Service DB
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=order_db
DB_SSLMODE=disable

# Inventory Service DB (uses port 5433 locally)
# INVENTORY_DB_HOST=localhost
# INVENTORY_DB_PORT=5433
# INVENTORY_DB_NAME=inventory_db

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Kafka Configuration
KAFKA_BROKERS=localhost:9092
