        {
          "expr": "histogram_quantile(0.99, sum(rate(otel_http_request_duration_seconds_bucket{service=\"order-service\"}[5m])) by (le))",
          "legendFormat": "P99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
