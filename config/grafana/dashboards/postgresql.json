  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "title": "Order DB Status",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "targets": [{ "expr": "up{job=\"order-db\"}", "legendFormat": "up" }],
      "fieldConfig": {
        "defaults": {
          "mappings": [{ "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } }, "type": "value" }],
          "thresholds": { "steps": [{ "value": 0, "color": "red" }, { "value": 1, "color": "green" }] }
        }
      }
    },
    {
      "title": "Inventory DB Status",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "targets": [{ "expr": "up{job=\"inventory-db\"}", "legendFormat": "up" }],
      "fieldConfig": {
        "defaults": {
          "mappings": [{ "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } }, "type": "value" }],
          "thresholds": { "steps": [{ "value": 0, "color": "red" }, { "value": 1, "color": "green" }] }
        }
      }
    },
    {
      "title": "Active Connections (Order)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "targets": [{ "expr": "pg_stat_activity_count{job=\"order-db\",state=\"active\"}", "legendFormat": "active" }],
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "value": 0, "color": "green" }, { "value": 10, "color": "yellow" }, { "value": 50, "color": "red" }] } } }
    },
    {
      "title": "Active Connections (Inventory)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "targets": [{ "expr": "pg_stat_activity_count{job=\"inventory-db\",state=\"active\"}", "legendFormat": "active" }],
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "value": 0, "color": "green" }, { "value": 10, "color": "yellow" }, { "value": 50, "color": "red" }] } } }
    },
    {
      "title": "Database Size (Order)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "targets": [{ "expr": "pg_database_size_bytes{job=\"order-db\",datname=\"order_db\"}", "legendFormat": "size" }],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },
    {
      "title": "Database Size (Inventory)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "targets": [{ "expr": "pg_database_size_bytes{job=\"inventory-db\",datname=\"inventory_db\"}", "legendFormat": "size" }],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },
    {
      "title": "Connections by State (Order DB)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        { "expr": "pg_stat_activity_count{job=\"order-db\"}", "legendFormat": "{{state}}" }
      ]
    },
    {
      "title": "Connections by State (Inventory DB)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        { "expr": "pg_stat_activity_count{job=\"inventory-db\"}", "legendFormat": "{{state}}" }
      ]
    },
    {
      "title": "Transactions/sec (Order DB)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        { "expr": "rate(pg_stat_database_xact_commit{job=\"order-db\",datname=\"order_db\"}[5m])", "legendFormat": "commits/s" },
        { "expr": "rate(pg_stat_database_xact_rollback{job=\"order-db\",datname=\"order_db\"}[5m])", "legendFormat": "rollbacks/s" }
      ]
    },
    {
      "title": "Transactions/sec (Inventory DB)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [
        { "expr": "rate(pg_stat_database_xact_commit{job=\"inventory-db\",datname=\"inventory_db\"}[5m])", "legendFormat": "commits/s" },
        { "expr": "rate(pg_stat_database_xact_rollback{job=\"inventory-db\",datname=\"inventory_db\"}[5m])", "legendFormat": "rollbacks/s" }
      ]
    },
    {
      "title": "Cache Hit Ratio (Order DB)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "targets": [
        { "expr": "pg_stat_database_blks_hit{job=\"order-db\",datname=\"order_db\"} / (pg_stat_database_blks_hit{job=\"order-db\",datname=\"order_db\"} + pg_stat_database_blks_read{job=\"order-db\",datname=\"order_db\"}) * 100", "legendFormat": "hit %" }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "thresholds": { "steps": [{ "value": 90, "color": "green" }, { "value": 80, "color": "yellow" }, { "value": 0, "color": "red" }] } } }
    },
    {
      "title": "Cache Hit Ratio (Inventory DB)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "targets": [
        { "expr": "pg_stat_database_blks_hit{job=\"inventory-db\",datname=\"inventory_db\"} / (pg_stat_database_blks_hit{job=\"inventory-db\",datname=\"inventory_db\"} + pg_stat_database_blks_read{job=\"inventory-db\",datname=\"inventory_db\"}) * 100", "legendFormat": "hit %" }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "thresholds": { "steps": [{ "value": 90, "color": "green" }, { "value": 80, "color": "yellow" }, { "value": 0, "color": "red" }] } } }
    },
    {
      "title": "Rows Fetched/sec (Order DB)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
      "targets": [
        { "expr": "rate(pg_stat_database_tup_fetched{job=\"order-db\",datname=\"order_db\"}[5m])", "legendFormat": "fetched/s" },
        { "expr": "rate(pg_stat_database_tup_returned{job=\"order-db\",datname=\"order_db\"}[5m])", "legendFormat": "returned/s" }
      ]
    },
    {
      "title": "Rows Fetched/sec (Inventory DB)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
      "targets": [
        { "expr": "rate(pg_stat_database_tup_fetched{job=\"inventory-db\",datname=\"inventory_db\"}[5m])", "legendFormat": "fetched/s" },
        { "expr": "rate(pg_stat_database_tup_returned{job=\"inventory-db\",datname=\"inventory_db\"}[5m])", "legendFormat": "returned/s" }
      ]
    },
    {
      "title": "Deadlocks (Both DBs)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 36 },
      "targets": [
        { "expr": "increase(pg_stat_database_deadlocks{job=\"order-db\"}[5m])", "legendFormat": "order-db" },
        { "expr": "increase(pg_stat_database_deadlocks{job=\"inventory-db\"}[5m])", "legendFormat": "inventory-db" }
      ],
      "fieldConfig": { "defaults": { "thresholds": { "steps": [{ "value": 0, "color": "green" }, { "value": 1, "color": "red" }] } } }
    },
    {
      "title": "Database Size Over Time",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 36 },
      "targets": [
        { "expr": "pg_database_size_bytes{job=\"order-db\",datname=\"order_db\"}", "legendFormat": "order_db" },
        { "expr": "pg_database_size_bytes{job=\"inventory-db\",datname=\"inventory_db\"}", "legendFormat": "inventory_db" }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    }
  ],
